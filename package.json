{
  "name": "meska-zafran-pos",
  "private": true,
  "version": "1.0.0",
  "description": "نظام إدارة المبيعات ونقاط البيع - مسك وزعفران",
  "author": "المهندس محمد أحمد",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "electron:dev": "concurrently -k \"vite --port 3000\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:32": "vite build && electron-builder --win nsis --ia32",
    "electron:build:portable": "vite build && electron-builder --win portable",
    "electron:build:portable:32": "vite build && electron-builder --win portable --ia32"
  },
  "build": {
    "appId": "com.meskazafran.pos",
    "productName": "Meska & Zafran POS",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/logo.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مسك وزعفران POS"
    },
    "portable": {
      "artifactName": "Musk-Zafran-POS-Portable.exe"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^22.3.27",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^9.1.0"
  }
}
